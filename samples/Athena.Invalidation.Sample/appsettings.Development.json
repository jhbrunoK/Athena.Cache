{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Athena.Invalidation": "Trace"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=:memory:",
    "Redis": "localhost:6379"
  },
  "InvalidationOptions": {
    "EnablePerformanceOptimizations": false,
    "EnableBackgroundProcessing": false,
    "BatchSize": 10
  }
}