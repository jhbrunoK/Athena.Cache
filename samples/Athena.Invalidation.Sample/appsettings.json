{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Athena.Invalidation": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=AthenaInvalidationSample;Integrated Security=true;TrustServerCertificate=true",
    "Redis": "localhost:6379"
  },
  "InvalidationOptions": {
    "EnablePerformanceOptimizations": true,
    "EnableBackgroundProcessing": true,
    "BatchSize": 100,
    "MaxRetries": 3,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerTimeoutSeconds": 30,
    "EnableDistributedInvalidation": true,
    "EnableTracking": true,
    "EnableMonitoring": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Database": 3,
    "KeyPrefix": "invalidation-sample"
  },
  "FusionCache": {
    "DefaultDurationSec": 300,
    "DefaultPriority": "Normal"
  }
}