<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Athena.Invalidation.AspNetCore</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>Athena Development Team</Authors>
    <Description>ASP.NET Core integration for the universal cache invalidation engine</Description>
    <PackageTags>cache;invalidation;caching;aspnetcore;dependency-injection</PackageTags>
    <PackageProjectUrl>https://github.com/jhbrunoK/Athena.Cache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jhbrunoK/Athena.Cache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Athena.Invalidation.Core/Athena.Invalidation.Core.csproj" />
    <ProjectReference Include="../Athena.Invalidation.Engine/Athena.Invalidation.Engine.csproj" />
    <ProjectReference Include="../Athena.Invalidation.Strategies/Athena.Invalidation.Strategies.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
  </ItemGroup>

</Project>