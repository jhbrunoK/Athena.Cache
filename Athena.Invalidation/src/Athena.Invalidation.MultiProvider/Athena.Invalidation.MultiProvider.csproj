<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Athena.Invalidation.MultiProvider</PackageId>
    <Version>0.4.0-alpha</Version>
    <Authors>Athena Development Team</Authors>
    <Description>Multi-provider cache invalidation engine supporting concurrent cache systems</Description>
    <PackageTags>cache;invalidation;multi-provider;concurrent;distributed;hybrid</PackageTags>
    <PackageProjectUrl>https://github.com/jhbrunoK/Athena.Cache</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jhbrunoK/Athena.Cache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Athena.Invalidation.Core/Athena.Invalidation.Core.csproj" />
    <ProjectReference Include="../Athena.Invalidation.FusionCache/Athena.Invalidation.FusionCache.csproj" />
    <ProjectReference Include="../Athena.Invalidation.Redis/Athena.Invalidation.Redis.csproj" />
    <ProjectReference Include="../Athena.Invalidation.MemoryCache/Athena.Invalidation.MemoryCache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.8" />
    <PackageReference Include="System.Threading.Tasks.Parallel" Version="4.3.0" />
  </ItemGroup>

</Project>