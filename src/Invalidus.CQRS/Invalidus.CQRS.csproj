<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <!-- Package Information -->
    <PackageId>Invalidus.CQRS</PackageId>
    <Title>Invalidus CQRS - Event-Driven Cache Invalidation</Title>
    <Description>
      Advanced CQRS and event-driven cache invalidation extensions for Invalidus - The Universal Cache Invalidation Engine.
      Provides command handling, event sourcing, read model management, and projection invalidation capabilities.
    </Description>
    <PackageTags>cache;invalidation;cqrs;event-sourcing;command-query;read-models;projections;event-driven</PackageTags>
    <RepositoryUrl>https://github.com/jhbrunoK/Athena.Cache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>jhbrunoK</Authors>
    <Company>Invalidus</Company>
    <Product>Invalidus - Universal Cache Invalidation Engine</Product>
    
    <!-- Version Information -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    
    <!-- Build Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Invalidus.Core/Invalidus.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="Serialization\" />
    <Folder Include="Snapshots\" />
    <Folder Include="Projectors\" />
  </ItemGroup>

</Project>