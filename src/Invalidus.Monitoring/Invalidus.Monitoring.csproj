<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <!-- Package Information -->
    <PackageId>Invalidus.Monitoring</PackageId>
    <Title>Invalidus Monitoring - Unified Cache and Invalidation Monitoring</Title>
    <Description>
      Comprehensive monitoring and analytics for Invalidus - The Universal Cache Invalidation Engine.
      Provides health checks, performance metrics, pattern analysis, alerting, and real-time monitoring of cache operations and invalidation patterns.
    </Description>
    <PackageTags>cache;invalidation;monitoring;metrics;health-checks;alerts;analytics;observability</PackageTags>
    <RepositoryUrl>https://github.com/jhbrunoK/Athena.Cache</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>jhbrunoK</Authors>
    <Company>Invalidus</Company>
    <Product>Invalidus - Universal Cache Invalidation Engine</Product>
    
    <!-- Version Information -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    
    <!-- Build Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Invalidus.Core/Invalidus.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="Collectors\" />
    <Folder Include="Exporters\" />
    <Folder Include="Dashboards\" />
  </ItemGroup>

</Project>